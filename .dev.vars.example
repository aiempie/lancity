BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gmail SMTP (use an app password, not the account password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM=

# ---- Live editor (Durable Object COLLABORATION) -------------------------------------------------
# Shared secret of the server-to-server routes /api/v1/live/convert-document and /force-close (min 16 chars).
# Generate with: openssl rand -hex 32
LIVE_SERVER_SECRET_KEY=
# Extra origins allowed to open the editor socket, comma separated. The origin of BETTER_AUTH_URL is always allowed.
# LIVE_CORS_ALLOWED_ORIGINS=
# Base URL that the asset copy job calls (POST {LIVE_URL}/convert-document/). Leave unset to only copy HTML.
# LIVE_URL=

# ---- Instance settings ---------------------------------------------------------------------------
# Encrypts secret values stored in instance_configurations. Changing it makes stored values unreadable.
# Generate with: openssl rand -hex 32
INSTANCE_ENCRYPTION_KEY=
# TELEMETRY_ENABLED=1
# OTLP_ENDPOINT=
# METRICS_PUSH_INTERVAL_MINUTES=360
# SERVICE_NAME=
# APP_VERSION=
# LATEST_VERSION_URL=
# INSTANCE_CHANGELOG_URL=

# ---- Public URLs (links in e-mail, GET /instances/info). Each falls back to BETTER_AUTH_URL ---------
# WEB_URL=
# APP_BASE_URL=
# ADMIN_BASE_URL=
# ADMIN_BASE_PATH=
# SPACE_BASE_URL=
# SPACE_BASE_PATH=
# Origins allowed to call the API from a browser, comma separated.
# CORS_ALLOWED_ORIGINS=

# ---- Extra sign-in providers (optional). Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/{github,gitlab,gitea}
# Each provider also needs IS_<PROVIDER>_ENABLED=1 in instance_configurations.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_ORGANIZATION_ID=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# GITLAB_HOST=https://gitlab.com
GITEA_CLIENT_ID=
GITEA_CLIENT_SECRET=
# GITEA_HOST=
# GITHUB_APP_NAME=
# SLACK_CLIENT_ID=

# ---- Rate limits (format: <count>/<second|minute|hour|day>) ------------------------------------------
# AUTHENTICATION_RATE_LIMIT=10/minute
# API_KEY_RATE_LIMIT=60/minute
# PUBLIC_ANON_RATE_LIMIT=120/minute
# Raise for integration tests (the default makes public write tests receive 429), e.g. 1000/minute.
# PUBLIC_WRITE_RATE_LIMIT=30/minute

# ---- Uploads and cleanup -------------------------------------------------------------------------
# FILE_SIZE_LIMIT=5242880
# UNUPLOADED_ASSET_DELETE_DAYS=7
# EMAIL_LOG_RETENTION_DAYS=7
# API_ACTIVITY_LOG_RETENTION_DAYS=14
# WEBHOOK_LOG_RETENTION_DAYS=14
# JOB_CLAIM_RETENTION_DAYS=7
# HARD_DELETE_AFTER_DAYS=60

# ---- Webhooks (SSRF guard), comma separated ------------------------------------------------------
# WEBHOOK_ALLOWED_IPS=
# WEBHOOK_ALLOWED_HOSTS=
# WEBHOOK_DISALLOWED_DOMAINS=

# ---- AI assistant and Unsplash (optional) -------------------------------------------------------
LLM_API_KEY=
# LLM_PROVIDER=openai
# LLM_MODEL=
UNSPLASH_ACCESS_KEY=
